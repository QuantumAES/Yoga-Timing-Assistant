<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Произносимые фразы. Хранится тип фразы, а не готовый текст (решение
        P1-6): текст собирается здесь, в момент произнесения, и переключается
        вместе с языком интерфейса.
    -->
    <string name="alert_voice_next_stage">Next: %1$s</string>
    <string name="alert_voice_session_finished">Class complete</string>

    <plurals name="alert_voice_minutes_left">
        <item quantity="one">%1$d minute remaining</item>
        <item quantity="other">%1$d minutes remaining</item>
    </plurals>

    <plurals name="alert_voice_seconds_left">
        <item quantity="one">%1$d second remaining</item>
        <item quantity="other">%1$d seconds remaining</item>
    </plurals>

    <!--
        Отсечка занятия. Говорит про занятие целиком, а не про этап, — и должна
        звучать иначе, чем «осталась минута», иначе инструктор их перепутает.
    -->
    <plurals name="alert_voice_wrap_up">
        <item quantity="one">Time to wrap up: %1$d minute of class left</item>
        <item quantity="other">Time to wrap up: %1$d minutes of class left</item>
    </plurals>
</resources>
