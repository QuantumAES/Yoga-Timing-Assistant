<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Тема окна до первого кадра Compose. Дальше всё рисует YtaTheme,
      поэтому здесь достаточно фона без ActionBar.
    -->
    <style name="Theme.Yta" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Yta.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!--
          Тот же слой, что и у иконки запуска: заставка и иконка обязаны быть
          одним знаком, иначе переход из лаунчера читается как запуск чужого
          приложения. Слой собирается скриптом (scripts/generate-logo.sh).
        -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Yta</item>
    </style>

</resources>
