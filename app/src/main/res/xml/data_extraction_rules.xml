<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup и перенос на новое устройство для Android 12+ (P1-11).
  Состав тот же, что и в `backup_rules.xml`, — и по тем же причинам: везём
  профили, журнал занятий и настройки, не везём снимок идущего занятия и
  служебные журналы Room (WAL/shm).

  Перенос устройства отличается от облачного бэкапа только каналом: занятие,
  идущее прямо сейчас, не переживает и его — `bootId` нового устройства
  другой (решение B-11).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="yoga-timing.db" />
        <include domain="file" path="datastore/user_prefs.preferences_pb" />

        <exclude domain="database" path="yoga-timing.db-wal" />
        <exclude domain="database" path="yoga-timing.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="yoga-timing.db" />
        <include domain="file" path="datastore/user_prefs.preferences_pb" />

        <exclude domain="database" path="yoga-timing.db-wal" />
        <exclude domain="database" path="yoga-timing.db-shm" />
    </device-transfer>
</data-extraction-rules>
