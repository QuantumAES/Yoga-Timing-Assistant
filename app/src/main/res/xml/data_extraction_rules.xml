<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup и перенос на новое устройство для Android 12+. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
        <exclude domain="file" path="datastore/session_state.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
        <exclude domain="file" path="datastore/session_state.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
