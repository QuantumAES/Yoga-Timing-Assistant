    <!--
      Два режима паузы (замечание 6). Плашка нажимается и переключает режим.
      В заголовке — часы самой паузы: на паузе это единственное растущее число,
      и без него непонятно, стоишь ты десять секунд или четыре минуты
      (замечание 3 полевой проверки 2026-08-05).
    -->
    <string name="timer_pause_session_title">Пауза занятия · %1$s</string>
    <string name="timer_pause_session_text">Время занятия стоит. Нажмите, чтобы оно шло</string>
    <string name="timer_pause_stage_title">Пауза этапа · %1$s</string>
    <string name="timer_pause_stage_text">Время занятия идёт: +%1$s. Нажмите, чтобы остановить</string>

    <!-- Пауза в режиме фокуса: кнопок нет, плашки нет — только это. -->
    <string name="timer_focus_paused">Пауза %1$s</string>
    <string name="timer_focus_paused_stage">Пауза этапа %1$s · время занятия идёт</string>

    <!--
      Отсечка бюджета (замечание 11). Заголовок называет остаток по часам
      прямо: «пора закругляться» — жаргон, который у половины инструкторов
      звучит как команда группе, а не как сообщение приложения (замечание 4
      полевой проверки 2026-08-05).
    -->
    <string name="timer_wrap_up_title">До завершения занятия %1$s</string>
    <string name="timer_wrap_up_text">В плане ещё %1$s</string>
    <string name="timer_wrap_up_fit">Ужать план</string>
    <string name="timer_wrap_up_hide">Оставить как есть</string>
    <!--
      Ручная поправка ±30 с. На экране от неё видны только знак и время —
      плашка стоит под цифрами, и «к этапу» ясно из её места. Эта строка
      читается вслух: незрячему пользователю место плашки не говорит ничего.
    -->
    <string name="timer_stage_adjustment">%1$s к этапу</string>

