    <!--
      Занятие с целевым временем. «До конца» — это про часы, а не про сумму
      этапов: число убывает равномерно и не прыгает от переключений
      (замечание 12 полевой проверки 2026-08-04).
    -->
    <string name="timer_budget_remaining">До конца %1$s</string>
    <string name="timer_budget_overrun">Перебор %1$s</string>
