<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="stats_title">Statistics</string>
    <string name="stats_back">Back</string>

    <string name="stats_period_week">Week</string>
    <string name="stats_period_month">Month</string>
    <string name="stats_period_year">Year</string>
    <string name="stats_period_all">All</string>
    <string name="stats_period_all_title">All time</string>
    <string name="stats_period_previous">Previous period</string>
    <string name="stats_period_next">Next period</string>

    <!-- Длительности сводки: часы с минутами и просто минуты. -->
    <string name="stats_duration_hm">%1$dh %2$dmin</string>
    <string name="stats_duration_m">%1$d min</string>

    <!--
      Подпись плитки: само число стоит над ней крупно, поэтому в строке его нет.
      ImpliedQuantity именно об этом и предупреждает — здесь это осознанно.
    -->
    <plurals name="stats_tile_sessions" tools:ignore="ImpliedQuantity">
        <item quantity="one">class</item>
        <item quantity="other">classes</item>
    </plurals>
    <string name="stats_tile_total">total time</string>
    <string name="stats_tile_average">average class</string>
    <string name="stats_tile_days">days practised</string>
    <!-- «9 из 30»: сколько дней периода содержат хотя бы одно занятие. -->
    <string name="stats_days_of">%1$d of %2$d</string>

    <string name="stats_weekdays_title">By day of the week</string>
    <!-- Столбик графика для TalkBack: картинка для незрячего пользователя пуста. -->
    <string name="stats_weekday_description">%1$s: %2$s, %3$s</string>
    <string name="stats_weekday_empty_description">%1$s: no classes</string>

    <string name="stats_profiles_title">By profile</string>

    <!-- Число занятий строкой: в разрезе по профилям и в описании столбика. -->
    <plurals name="stats_sessions_count">
        <item quantity="one">%1$d class</item>
        <item quantity="other">%1$d classes</item>
    </plurals>

    <string name="stats_empty_title">No classes in this period</string>
    <string name="stats_empty_hint">A class longer than a minute lands here on its own, the moment it ends.</string>
    <string name="stats_empty_action">Back to profiles</string>
</resources>
